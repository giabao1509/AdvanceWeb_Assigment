{
  "balance_after_revoke": {
    "steps": [
      {
        "service": "Taxi server",
        "endpoint": "POST /demo/balance",
        "status": 200,
        "response": {
          "mode": "baseline",
          "action": "balance",
          "status": "completed"
        },
        "explanation": "Taxi điều phối thao tác ở server. Browser chỉ nhận kết quả đã che; token và client secret không được gửi về giao diện."
      },
      {
        "service": "Wallet API",
        "endpoint": "GET /wallet/balance",
        "status": 200,
        "response": {
          "user": "alice",
          "balance": 910000,
          "currency": "VND"
        },
        "explanation": "API tự kiểm JWT qua JWKS, scope và principal trước khi xử lý dữ liệu ví."
      }
    ]
  },
  "refresh_after_revoke": {
    "status": 200,
    "body": {
      "steps": [
        {
          "service": "Taxi server",
          "endpoint": "POST /demo/refresh",
          "status": 200,
          "response": {
            "mode": "baseline",
            "action": "refresh",
            "status": "completed"
          },
          "explanation": "Taxi điều phối thao tác ở server. Browser chỉ nhận kết quả đã che; token và client secret không được gửi về giao diện."
        },
        {
          "service": "Wallet AS",
          "endpoint": "POST /token · refresh_token",
          "status": 200,
          "response": {
            "grant": "refresh_token",
            "token_type": "bearer",
            "expires_in": 120,
            "refresh_token": true,
            "sub": "alice",
            "aud": "wallet-api",
            "scope": "offline_access wallet:charge wallet:read",
            "principal_type": "user",
            "exp": 1792637840,
            "tokens": "[REDACTED]"
          },
          "explanation": "Taxi refresh phía server và lưu token mới trước khi nhả khóa theo người dùng."
        }
      ]
    }
  }
}
