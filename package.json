{
  "name": "block7-checkout-saga-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.17.1" },
  "scripts": {
    "build:ui": "tsx scripts/build-ui.ts",
    "predev": "npm run build:ui",
    "prestart:order": "npm run build:ui",
    "dev": "tsx --env-file-if-exists=.env scripts/dev.ts",
    "start": "npm run dev",
    "start:order": "tsx --env-file-if-exists=.env src/order/server.ts",
    "start:inventory": "tsx --env-file-if-exists=.env src/inventory/server.ts",
    "start:payment": "tsx --env-file-if-exists=.env src/payment/server.ts",
    "start:ui": "tsx --env-file-if-exists=.env scripts/start-ui.ts",
    "service": "tsx --env-file-if-exists=.env scripts/control.ts",
    "resume": "tsx --env-file-if-exists=.env scripts/resume.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/http.test.ts",
    "test:manual": "tsx --test --test-concurrency=1 tests/manual.test.ts",
    "test:retry": "tsx --test --test-concurrency=1 tests/retry.test.ts",
    "test:observability": "tsx --test --test-concurrency=1 tests/observability.test.ts",
    "test:shared": "tsx --test --test-concurrency=1 tests/shared.test.ts",
    "test:f4": "tsx --test --test-concurrency=1 tests/f4.test.ts",
    "test:v3": "tsx --test --test-concurrency=1 tests/v3.test.ts",
    "test:ui": "tsx scripts/ui-smoke.ts",
    "test:ui:manual": "tsx scripts/manual-ui-smoke.ts",
    "test:ui:recovery": "tsx scripts/recovery-ui-smoke.ts",
    "test:ui:stock": "tsx scripts/stock-ui-smoke.ts",
    "test:ui:state": "tsx scripts/ui-state-smoke.ts",
    "test:ui:history": "tsx scripts/history-ui-smoke.ts",
    "test:ui:shared": "tsx scripts/shared-ui-smoke.ts",
    "demo:kill-payment": "tsx scripts/demo-kill-payment.ts",
    "demo:restart-order": "tsx scripts/demo-restart-order.ts",
    "evidence": "tsx scripts/evidence.ts",
    "evidence:v3": "tsx scripts/v3-evidence.ts",
    "demo:refund-failure": "tsx scripts/demo-refund-failure.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/reset.ts",
    "db:inspect": "tsx --env-file-if-exists=.env scripts/db-inspect.ts",
    "db:export": "tsx --env-file-if-exists=.env scripts/db-inspect.ts --export"
  },
  "dependencies": { "express": "^5.1.0" },
  "devDependencies": { "playwright": "^1.56.0", "typescript": "^5.9.3", "tsx": "^4.20.6", "@types/node": "^22.17.1", "@types/express": "^5.0.3" }
}
