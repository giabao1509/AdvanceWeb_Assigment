{
  "balance_after_revoke": {
    "steps": [
      {
        "service": "Wallet API",
        "endpoint": "GET /wallet/balance",
        "status": 200,
        "response": {
          "user": "alice",
          "balance": 910000,
          "currency": "VND"
        },
        "explanation": "API tự kiểm JWT qua JWKS, scope và principal trước khi xử lý dữ liệu ví."
      }
