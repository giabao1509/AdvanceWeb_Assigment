  "refresh_after_revoke": {
    "status": 409,
    "body": {
      "error": "invalid_grant",
      "steps": [
        {
          "service": "Wallet AS",
          "endpoint": "POST /token · refresh_token",
          "status": 400,
          "response": {
            "error": "invalid_grant"
          },
          "explanation": "Taxi ngừng dùng refresh token và chuyển về chưa liên kết; không retry token cũ vô hạn."
        }
      ]
    }
  }
}
