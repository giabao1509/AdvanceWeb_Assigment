{
  "name": "task-authorization-minilab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "test:ui": "node scripts/ui-smoke.js",
    "test:idor": "node scripts/idor-regression.js",
    "evidence": "node scripts/collect-evidence.js",
    "db:reset": "node --env-file-if-exists=.env src/reset.js",
    "fga:build": "node scripts/build-openfga-model.js",
    "fga:init": "node --env-file-if-exists=.env scripts/openfga-sync.js",
    "fga:sync": "node --env-file-if-exists=.env scripts/openfga-sync.js",
    "test:fga:model": "node scripts/build-openfga-model.js --check && node --test --test-name-pattern=\"model matrix\" test/openfga.test.js",
    "test:fga:integration": "node --test test/authorization.test.js test/openfga.test.js"
  },
  "dependencies": {
    "@openfga/sdk": "0.9.7",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@openfga/syntax-transformer": "0.2.2"
  },
  "overrides": {
    "@openfga/sdk": {
      "axios": "1.21.0"
    }
  }
}
